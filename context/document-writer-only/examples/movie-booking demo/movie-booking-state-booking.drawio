          <mxGeometry height="30" width="520" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" style="ellipse;fillColor=strokeColor;html=1;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="80" y="215" as="geometry" />
        </mxCell>
        <mxCell id="s_draft" parent="1" style="shape=umlState;rounded=1;whiteSpace=wrap;html=1;" value="Draft" vertex="1">
