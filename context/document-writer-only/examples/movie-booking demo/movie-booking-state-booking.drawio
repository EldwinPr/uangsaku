        </mxCell>
        <mxCell id="s_confirmed" parent="1" style="shape=umlState;rounded=1;whiteSpace=wrap;html=1;" value="Confirmed" vertex="1">
          <mxGeometry height="60" width="160" x="520" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s_expired" parent="1" style="shape=umlState;rounded=1;whiteSpace=wrap;html=1;" value="Expired" vertex="1">
