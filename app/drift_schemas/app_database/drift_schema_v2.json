  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"account_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"group\" TEXT NOT NULL, \"opening_amount\" INTEGER NOT NULL, \"settled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"settled\" IN (0, 1)), \"settled_at\" INTEGER NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"category_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "subcategories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subcategories\" (\"subcategory_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NOT NULL REFERENCES categories (category_id), \"name\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "budget_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budget_groups\" (\"budget_group_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"transaction_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"occurred_on\" INTEGER NOT NULL, \"from_account_id\" INTEGER NULL REFERENCES accounts (account_id), \"to_account_id\" INTEGER NULL REFERENCES accounts (account_id), \"category_id\" INTEGER NULL REFERENCES categories (category_id), \"subcategory_id\" INTEGER NULL REFERENCES subcategories (subcategory_id), \"budget_group_id\" INTEGER NULL REFERENCES budget_groups (budget_group_id), \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "budget_periods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budget_periods\" (\"budget_period_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"budget_group_id\" INTEGER NOT NULL REFERENCES budget_groups (budget_group_id), \"starts_on\" INTEGER NOT NULL, \"ends_on\" INTEGER NOT NULL, \"amount\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"settings_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"currency\" TEXT NOT NULL);"
        }
      ]
    }
