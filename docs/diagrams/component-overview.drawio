        <mxCell id="e_acc_txn" parent="1" style="endArrow=block;endFill=1;dashed=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" value="reads: SQL join on Transactions (UC-01, UC-02, UC-10)" edge="1" source="c_accounts" target="c_transactions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_txn_acc" parent="1" style="endArrow=block;endFill=1;dashed=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" value="reads: Accounts &#8212; account picker (UC-04..UC-08)" edge="1" source="c_transactions" target="c_accounts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_txn_bud" parent="1" style="endArrow=block;endFill=1;dashed=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" value="reads: BudgetGroups &#8212; budget picker (UC-04..UC-08)" edge="1" source="c_transactions" target="c_budgeting">
