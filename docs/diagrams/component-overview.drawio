        <mxCell id="e_bud_txn" parent="1" style="endArrow=block;endFill=1;dashed=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" value="reads: SQL join on Transactions (UC-12)" edge="1" source="c_budgeting" target="c_transactions">
          <mxGeometry relative="1" as="geometry" />
