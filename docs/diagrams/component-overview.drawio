        <mxCell id="note_boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" value="No backend, no queue, no HTTP &#8212; backup is an export file, not sync. The drift isolate is the only real boundary in this system; every module-to-module edge is in-process." vertex="1">
          <mxGeometry height="120" width="600" x="60" y="500" as="geometry" />
        </mxCell>
        <mxCell id="note_d1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" value="Modules reach each other's data by SQL join on the shared database &#8212; no module calls another module's DAO. Table ownership is therefore enforced by nothing, not even by convention within a DAO. Confirmed by the owner, ISSUE-005 D1." vertex="1">
          <mxGeometry height="120" width="600" x="700" y="500" as="geometry" />
        </mxCell>
        <mxCell id="note_settings" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" value="Settings has no call edge and no foreign key. Its single value decides what the integer in every amount column means (IDR exponent 0, USD exponent 2), so every module depends on it semantically while none of them call it. Recorded here because a dependency with no referential trace is the kind this diagram exists to make visible." vertex="1">
          <mxGeometry height="100" width="1240" x="60" y="640" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
