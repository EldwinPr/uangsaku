        <mxCell id="e_acc_db" parent="1" style="endArrow=block;endFill=1;dashed=1;dashPattern=1 3;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" value="isolate call: message-passed" edge="1" source="c_accounts" target="c_appdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_txn_db" parent="1" style="endArrow=block;endFill=1;dashed=1;dashPattern=1 3;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="isolate call: message-passed" edge="1" source="c_transactions" target="c_appdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bud_db" parent="1" style="endArrow=block;endFill=1;dashed=1;dashPattern=1 3;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" value="isolate call: message-passed" edge="1" source="c_budgeting" target="c_appdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_set_db" parent="1" style="endArrow=block;endFill=1;dashed=1;dashPattern=1 3;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="isolate call: message-passed" edge="1" source="c_settings" target="c_appdb">
