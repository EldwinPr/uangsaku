        <mxCell id="c_settings" parent="1" style="shape=component;align=left;spacingLeft=36;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" value="&#171;component&#187;&lt;br&gt;Settings" vertex="1">
