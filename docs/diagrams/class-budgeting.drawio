        <mxCell id="n1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Arrows mean &quot;calls / depends on&quot; and only ever point left to right. A screen never touches the DAO or the database &#8212; it watches a provider." vertex="1">
          <mxGeometry height="60" width="660" x="40" y="690" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="drift also generates a row class and a companion from each table declaration (BudgetPeriod / BudgetPeriodsCompanion). Omitted here by decision &#8212; only hand-written classes get a box." vertex="1">
          <mxGeometry height="110" width="440" x="1420" y="690" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Clock is injected rather than read from the system so that anything date-dependent can be tested without changing the device date. Its original justification was FR-16's lock, which no longer exists; it survives that removal only because deciding which period is the current one is still a question about today's date. That is a weaker reason than before - if a later pass finds nothing actually asking Clock the time, drop it rather than keep it out of habit." vertex="1">
          <mxGeometry height="70" width="1020" x="40" y="770" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="There is no budget lifecycle left to draw. A period ran open -&gt; locked -&gt; closed until 2026-08-20, when the owner removed the lock and made budgets full CRUD like every other entity. &quot;Locked&quot; ceased to exist and the remaining pair collapsed into a date comparison that restricts nothing, so BudgetPeriodState is gone from this diagram and the state diagram was deleted with the rule it described. starts_on / ends_on stay - they are what make quarterly and yearly rollups a date-range sum (NFR-3)." vertex="1">
          <mxGeometry height="70" width="1020" x="40" y="840" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
