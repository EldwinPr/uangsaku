        <mxCell id="n1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Changing the currency re-labels existing amounts, it does not convert them: 50,000 recorded as IDR reads as 50,000 USD. The app warns and proceeds - NFR-4's fit criterion is zero refusals, so it may not block the change. Legal values: docs/enums.md" vertex="1">
          <mxGeometry height="70" width="1000" x="40" y="660" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Every amount column in the other three modules is an int counting this currency's minor unit (IDR exponent 0, USD exponent 2). This one-row table therefore changes the meaning of Account.opening_amount, Transaction.amount and Budget_Period.amount - a coupling with no foreign key." vertex="1">
          <mxGeometry height="70" width="1000" x="40" y="750" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Language, theme mode and theme color are UI preferences with no effect on any recorded amount (FEAT03) - unlike currency, changing them re-derives nothing and needs no warning; every control on SettingsScreen stays enabled at all times regardless (NFR-4)." vertex="1">
          <mxGeometry height="60" width="1000" x="40" y="840" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="HelpScreen (FEAT10) draws no arrows in this diagram on purpose: static explanatory text about accounts/transactions/budgets/debts, reused verbatim from FEAT09's picker-description ARB keys where it overlaps, nothing read from the database." vertex="1">
          <mxGeometry height="45" width="1000" x="40" y="910" as="geometry" />
