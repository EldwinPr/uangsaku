        <mxCell id="n1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Arrows mean &quot;calls / depends on&quot; and only ever point left to right. A screen never touches the DAO or the database &#8212; it watches a provider." vertex="1">
          <mxGeometry height="60" width="660" x="40" y="770" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="drift also generates a row class (Account) and a companion (AccountsCompanion) from the Accounts table declaration. Omitted here by decision &#8212; only hand-written classes get a box." vertex="1">
          <mxGeometry height="90" width="380" x="1100" y="770" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Reads travel back the other way as streams: a row changes, drift pushes a new value up through the DAO and the provider, and every widget watching that provider rebuilds. The screen never receives an answer from the write it triggered &#8212; it sees the result arrive on the read path, the same as any other change. This is why no balance is ever stored (NFR-2)." vertex="1">
          <mxGeometry height="70" width="1020" x="40" y="870" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Legal values for every enum: docs/enums.md" vertex="1">
          <mxGeometry height="30" width="280" x="1480" y="545" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="AccountDao.delete() is a soft delete (Q3, decisions.md 2026-08-23): it sets Accounts.deleted/deleted_at, never DELETE FROM Accounts. watchPosition()/watchBalances()/watchDebtProgress() filter WHERE NOT deleted; TransactionDao.watchAll() (UC-09) does not, so a deleted account's history still displays." vertex="1">
          <mxGeometry height="60" width="1020" x="40" y="950" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
