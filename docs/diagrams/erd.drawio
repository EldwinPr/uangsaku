<mxCell id="note_account" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="No stored balance. Every figure is derived from Transaction (NFR-2)." vertex="1">
<mxGeometry height="34" width="260" x="60" y="320" as="geometry" />
</mxCell>
<mxCell id="note_transaction" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="to_account_id NULL =&gt; the money left the system, i.e. it is spending. Transfers and lending have both ends set, so they are never counted as spending (FR-8, FR-9)." vertex="1">
<mxGeometry x="480" y="440" width="210" height="115" as="geometry" />
</mxCell>
<mxCell id="note_transaction_note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="note is nullable free-text. Optional to fill in; nothing in the app reads it to make a decision; not searchable yet (decided 2026-08-21 - that is UC-09's surface)." vertex="1">
<mxGeometry x="900" y="440" width="190" height="140" as="geometry" />
</mxCell>
<mxCell id="note_subcategory" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Exactly two levels - no self-referencing nesting (FR-10)." vertex="1">
<mxGeometry height="34" width="220" x="820" y="350" as="geometry" />
