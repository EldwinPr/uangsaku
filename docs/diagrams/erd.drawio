<mxCell id="note_settings" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontStyle=2;whiteSpace=wrap;" value="Amounts are integer minor units, never floating point (NFR-2). The exponent comes from Settings.currency: IDR = 0 (whole rupiah), USD = 2 (cents). One currency for the whole app; no per-account currency and no conversion. Legal values: docs/enums.md" vertex="1">
<mxGeometry height="150" width="320" x="290" y="565" as="geometry" />
